{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeviceSteer",
  "version": "1.0.0-beta.7",
  "identifier": "com.sunghyunkim.devicesteer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "DeviceSteer",
        "width": 1200,
        "height": 840,
        "minWidth": 640,
        "minHeight": 520,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 16,
          "y": 25
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/sunghyun-k/devicesteer/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk1MDBBMEQ3OTk5OTg1N0QKUldSOWhabVoxNkFBbGNiYml1bVBoaUpSc3FKMDk1UzFWZ21ZaWgrOGR1Q0tHUy9KbzF6a0UxbDYK",
      "requireSignedVersion": true
    }
  }
}
